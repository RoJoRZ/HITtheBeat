{
  "name": "hitthebeat",
  "version": "0.0.22",
  "private": true,
  "packageManager": "pnpm@11.25.0",
  "description": "Een persoonlijk oefenmaatje voor muzikanten.",
  "author": "RoJoRZ",
  "license": "UNLICENSED",
  "type": "module",
  "main": "electron/main.mjs",
  "scripts": {
    "setup:desktop": "install-electron",
    "dev": "node scripts/dev.mjs",
    "preview": "vite --host 127.0.0.1",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.electron.json",
    "build": "pnpm typecheck && vite build",
    "start": "electron .",
    "test": "node --test tests/*.test.mjs",
    "test:desktop": "playwright test",
    "package:mac": "pnpm build && electron-builder --mac zip --publish never",
    "package:win": "pnpm build && electron-builder --win zip --x64 --publish never"
  },
  "build": {
    "appId": "nl.rojorz.hitthebeat",
    "productName": "HITtheBeat",
    "asar": true,
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json",
      "build/icon.png"
    ],
    "artifactName": "HITtheBeat-${version}-${os}-${arch}.${ext}",
    "mac": {
      "category": "public.app-category.music",
      "identity": "-",
      "target": [
        "zip"
      ],
      "icon": "build/icon.icns"
    },
    "win": {
      "target": [
        "zip"
      ],
      "icon": "build/icon.ico"
    }
  },
  "dependencies": {
    "@fontsource/source-sans-3": "5.3.0",
    "lucide-react": "1.54.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "signalsmith-stretch": "1.3.2"
  },
  "devDependencies": {
    "@breezystack/lamejs": "1.2.7",
    "@playwright/test": "1.64.0",
    "@types/node": "26.6.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "electron": "44.7.0",
    "electron-builder": "26.15.3",
    "typescript": "7.0.2",
    "vite": "8.3.4"
  }
}
